# AI provider: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional: any OpenRouter model slug (default openai/gpt-4o-mini)
AI_MODEL=
# Optional: your public site URL, sent to OpenRouter for attribution
OPENROUTER_SITE_URL=

# Required only once Prisma/Postgres (Supabase) is wired in
DATABASE_URL=postgresql://user:password@localhost:5432/itineraxz
# Optional: override the API base URL (default https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=
